{
  "$schema": "https://raw.githubusercontent.com/bitwise-media-group/evolve/main/schemas/evals.schema.json",
  "skill_name": "actions-reusable-workflows",
  "evals": [
    {
      "id": "wire-ci",
      "prompt": "Set up continuous integration for this repository using our shared reusable workflows. Add the CI caller workflow at .github/workflows/ci.yaml that runs on pushes and pull requests to main.",
      "assertions": [
        {
          "type": "file_exists",
          "path": ".github/workflows/ci.yaml"
        },
        {
          "type": "regex",
          "path": ".github/workflows/ci.yaml",
          "pattern": "bitwise-media-group/github-workflows/\\.github/workflows/ci\\.yaml@[0-9a-f]{40}"
        },
        {
          "type": "regex",
          "path": ".github/workflows/ci.yaml",
          "pattern": "contents:\\s*read"
        },
        {
          "type": "not_regex",
          "path": ".github/workflows/ci.yaml",
          "pattern": "pull_request_target"
        },
        {
          "type": "not_regex",
          "path": ".github/workflows/ci.yaml",
          "pattern": "@0{40}|x-release-please-version"
        }
      ]
    },
    {
      "id": "wire-release-vanity",
      "prompt": "This is a reusable-actions repository whose consumers pin @v1. Add the release caller workflow at .github/workflows/release.yaml using our reusable release workflow, with vanity tags enabled.",
      "assertions": [
        {
          "type": "file_exists",
          "path": ".github/workflows/release.yaml"
        },
        {
          "type": "regex",
          "path": ".github/workflows/release.yaml",
          "pattern": "bitwise-media-group/github-workflows/\\.github/workflows/release\\.yaml@[0-9a-f]{40}"
        },
        {
          "type": "regex",
          "path": ".github/workflows/release.yaml",
          "pattern": "vanity-tags:\\s*true"
        },
        {
          "type": "regex",
          "path": ".github/workflows/release.yaml",
          "pattern": "contents:\\s*write"
        },
        {
          "type": "not_regex",
          "path": ".github/workflows/release.yaml",
          "pattern": "@0{40}|x-release-please-version"
        }
      ]
    },
    {
      "id": "wire-security",
      "prompt": "Add the reusable CodeQL security analysis caller workflow at .github/workflows/security.yaml for this repository.",
      "assertions": [
        {
          "type": "file_exists",
          "path": ".github/workflows/security.yaml"
        },
        {
          "type": "regex",
          "path": ".github/workflows/security.yaml",
          "pattern": "bitwise-media-group/github-workflows/\\.github/workflows/security\\.yaml@[0-9a-f]{40}"
        },
        {
          "type": "regex",
          "path": ".github/workflows/security.yaml",
          "pattern": "security-events:\\s*write"
        },
        {
          "type": "not_regex",
          "path": ".github/workflows/security.yaml",
          "pattern": "@0{40}|x-release-please-version"
        }
      ]
    },
    {
      "id": "wire-merge-flow",
      "prompt": "Enable the shared fast-forward /merge and auto-merge flow in this repository. Our CI caller workflow at .github/workflows/ci.yaml is named \"Build\". Add every caller the merge flow needs.",
      "files": [
        "files/.github/workflows/ci.yaml"
      ],
      "assertions": [
        {
          "type": "regex",
          "path": ".github/workflows/merge.yaml",
          "pattern": "bitwise-media-group/github-workflows/\\.github/workflows/merge\\.yaml@[0-9a-f]{40}"
        },
        {
          "type": "regex",
          "path": ".github/workflows/merge.yaml",
          "pattern": "workflows:\\s*\\[[^\\]]*\"Build\"[^\\]]*\\]"
        },
        {
          "type": "regex",
          "path": ".github/workflows/merge.yaml",
          "pattern": "\"Merge Review Ack\""
        },
        {
          "type": "regex",
          "path": ".github/workflows/merge.yaml",
          "pattern": "permissions:\\s*\\{\\}"
        },
        {
          "type": "file_exists",
          "path": ".github/workflows/merge-review-ack.yaml"
        },
        {
          "type": "not_regex",
          "path": ".github/workflows/merge.yaml",
          "pattern": "workflows:\\s*\\[[^\\]]*\"CI\""
        }
      ]
    }
  ]
}
